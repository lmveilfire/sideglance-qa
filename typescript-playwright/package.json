{
  "name": "sideglance-qa",
  "version": "1.0.0",
  "description": "SideGlance QA Automation Suite",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --grep @api",
    "test:e2e": "playwright test --grep @e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "author": "Lyusi Mur",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.41",
    "allure-playwright": "^3.7.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.10.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
