{
  "name": "sideglance-qa",
  "version": "1.0.0",
  "description": "SideGlance QA Automation Suite",
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:api": "npx playwright test tests/api",
    "test:e2e": "npx playwright test tests/ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check .",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "author": "Lyusi Mur",
  "license": "ISC",
  "imports": {
    "#api/*": "./src/api/*.ts",
    "#clients/*": "./src/clients/*.ts",
    "#pages/*": "./src/pages/*.ts",
    "#helpers/*": "./src/helpers/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#fixtures/*": "./src/fixtures/*.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.19.41",
    "allure-playwright": "^2.9.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.2",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
